<div data-cmp-data-layer="{&#34;title-fa781c838b&#34;:{&#34;@type&#34;:&#34;saccounty/components/content/title/v1/title&#34;,&#34;repo:modifyDate&#34;:&#34;2025-12-10T17:50:50Z&#34;,&#34;dc:title&#34;:&#34;Current Measure Information&#34;}}" id="title-fa781c838b" class="cmp-title">
    <h1 class="cmp-title__text">Current Measure Information</h1>
