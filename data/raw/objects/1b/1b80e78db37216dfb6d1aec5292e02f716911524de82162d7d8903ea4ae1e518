	<div class="inner col col24 first last id2c5f84b6-3565-4315-a724-20c37061ab8d" style="" data-widgetcontainerid="2c5f84b6-3565-4315-a724-20c37061ab8d">	
<div class="widget editor pageStyles narrow" id="divEditor8f95c320-0f83-4ac3-8eb3-e91e66a3c81f" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
